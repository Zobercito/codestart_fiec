# URL del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clave anon: es la que viaja al navegador. Publicable sin riesgo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role: SOLO servidor (migraciones, seed, scripts).
# Nunca la expongas con NEXT_PUBLIC_ ni la subas a ningun lado.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña de la base de datos, para la CLI de Supabase
SUPABASE_DB_PASSWORD=

# Connection string del pooler: para db:seed y generación de tipos.
# Formato: postgresql://postgres.<ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
